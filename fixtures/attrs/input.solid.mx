import { createSignal } from "solid-js";

export function Attrs(props: { extra?: Record<string, unknown> }) {
  const [active, setActive] = createSignal(false);
  const [color, setColor] = createSignal("red");
  let el: HTMLDivElement | undefined;

  return (
    <div
      id="panel"
      data-count=color()
      disabled
      ...props.extra
      class={active: active()}
      style={color: color()}
      ref=el
      onScroll(_e) { setActive(true); setColor("blue") }
      prop:value=color()
    >
      static<p.badge.big class={on: active()}>shorthand plus object</p>
    </div>
  );
}
