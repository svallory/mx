{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/fixtures/**/__golden__",
      "!**/fixtures/**/*.solid.mx",
      "!**/fixtures-marko",
      "!**/.probe*",
      "!packages/mx-parser/src/babel",
      "!packages/mx-parser/dist",
      "!packages/tree-sitter-solidmx/vendor",
      "!packages/tree-sitter-solidmx/src",
      "!packages/tree-sitter-solidmx/test/corpus",
      "!packages/tree-sitter-solidmx/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/fixtures/**/twin.tsx"],
      "linter": {
        "rules": {
          "a11y": { "useButtonType": "off" }
        }
      }
    },
    {
      "includes": ["examples/astro-static/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/astro/src/astro-template.test.ts",
        "packages/astro/src/astro-template.ts",
        "packages/astro/src/server.test.ts",
        "packages/astro/src/vite-pages.test.ts",
        "packages/astro/src/vite-pages.ts",
        "packages/core/src/compile.ts",
        "packages/core/src/core.ts",
        "packages/core/src/emit-statement.test.ts",
        "packages/core/src/hooks.test.ts",
        "packages/translator/scripts/consumer-check.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noTemplateCurlyInString": "off" }
        }
      }
    },
    {
      "includes": ["packages/core/src/compile.ts", "packages/core/src/core.ts"],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "on" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    },
    {
      "includes": ["packages/translator/src/translate.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noTemplateCurlyInString": "info" }
        }
      }
    }
  ]
}
