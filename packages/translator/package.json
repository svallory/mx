{
  "name": "@markox/translator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/bun.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun --tsconfig-override=../../tsconfig.base.json test src/bun.test.ts",
    "example": "bun run --tsconfig-override=../../tsconfig.base.json src/example.ts"
  },
  "dependencies": {
    "@marko/compiler": "5.42.5",
    "@markox/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}
