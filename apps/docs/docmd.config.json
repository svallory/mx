{
  "title": "MX",
  "url": "https://mxlang.dev",
  "src": "docs",
  "out": "site",
  "engine": "js",
  "layout": {
    "spa": true,
    "header": { "enabled": true },
    "sidebar": { "collapsible": true, "defaultCollapsed": false },
    "optionsMenu": {
      "position": "sidebar-top",
      "components": { "search": true, "themeSwitch": true }
    },
    "footer": {
      "style": "minimal",
      "content": "MX is a template language born from Marko.",
      "branding": true
    }
  },
  "theme": {
    "name": "default",
    "appearance": "system",
    "codeHighlight": true
  },
  "minify": true,
  "autoTitleFromH1": true,
  "copyCode": true,
  "pageNavigation": true,
  "navigation": [
    { "title": "Introduction", "path": "/", "icon": "book-open" },
    {
      "title": "Language",
      "icon": "code",
      "children": [
        { "title": "Structural tags", "path": "/language/structural-tags/" },
        {
          "title": "Attribute tags and tag params",
          "path": "/language/attribute-tags-and-params/"
        },
        {
          "title": "Define, const, static, import",
          "path": "/language/define-const-static-import/"
        },
        {
          "title": "Interpolation and escaping",
          "path": "/language/interpolation/"
        },
        { "title": "Stateful tags", "path": "/language/stateful-tags/" },
        { "title": "Errors", "path": "/language/errors/" }
      ]
    },
    {
      "title": "Architecture",
      "icon": "layout-grid",
      "children": [
        { "title": "Core and hosts", "path": "/architecture/core-and-hosts/" },
        { "title": "The IR", "path": "/architecture/ir/" },
        {
          "title": "Policy and hooks",
          "path": "/architecture/policy-and-hooks/"
        }
      ]
    },
    {
      "title": "Hosts",
      "icon": "server",
      "children": [
        { "title": "HTML host", "path": "/hosts/html/" },
        { "title": "Astro host", "path": "/hosts/astro/" },
        { "title": "SolidMX", "path": "/hosts/solidmx/" }
      ]
    },
    {
      "title": "Editors",
      "icon": "keyboard",
      "children": [
        { "title": "Zed", "path": "/editors/zed/" },
        { "title": "VS Code", "path": "/editors/vscode/" },
        { "title": "Language server", "path": "/editors/language-server/" }
      ]
    },
    { "title": "Contributing", "path": "/contributing/", "icon": "git-branch" },
    {
      "title": "Design notes",
      "icon": "lightbulb",
      "children": [
        {
          "title": "Why MX has no resume",
          "path": "/design-notes/marko-runtime-modes/"
        },
        {
          "title": "Arbitrary code in templates",
          "path": "/design-notes/arbitrary-code-in-templates/"
        },
        {
          "title": "MX vs JSX for framework authors",
          "path": "/design-notes/mx-vs-jsx/"
        }
      ]
    },
    {
      "title": "GitHub",
      "path": "https://github.com/mxlang/mx",
      "icon": "github",
      "external": true
    }
  ],
  "plugins": {
    "seo": {
      "defaultDescription": "MX is a template language born from Marko: one markup language, many hosts."
    }
  }
}
