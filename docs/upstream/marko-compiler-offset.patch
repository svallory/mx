 packages/compiler/src/babel-plugin/parser.js  | 48 ++++++++--
 packages/compiler/src/babel-utils/loc.js      | 23 +++--
 packages/compiler/src/babel-utils/parse.js    |  8 +-
 .../compiler/test/parser-locations.test.js    | 87 ++++++++++++++++++-
 5 files changed, 167 insertions(+), 14 deletions(-)

diff --git a/packages/compiler/config.d.ts b/packages/compiler/config.d.ts
index e49787700..3de5e89d6 100644
--- a/packages/compiler/config.d.ts
+++ b/packages/compiler/config.d.ts
@@ -13,6 +13,21 @@ declare const Config: {
   runtimeId?: string | null;
   ast?: boolean;
   code?: boolean;
+  /**
+   * When compiling a substring of a larger document (e.g. an embedded
+   * template region), gives the parser a base position so every reported
+   * offset, line and column is relative to the enclosing document instead
+   * of the substring passed as `code`.
+   */
+  htmlParseOptions?: {
+    preserveWhitespace?: boolean;
+    /** Character offset of `code`'s first character in the enclosing document. */
+    startOffset?: number;
+    /** Zero-based line of `code`'s first character in the enclosing document. */
+    startLine?: number;
+    /** Column of `code`'s first character in the enclosing document (applied only to its first line). */
+    startColumn?: number;
+  };
   /** Implemented by the Marko 5 (class API) translator only; currently inert under the Marko 6 translator. */
   writeVersionComment?: boolean;
   /** Implemented by the Marko 5 (class API) translator only; currently inert under the Marko 6 translator. */
diff --git a/packages/compiler/src/babel-plugin/parser.js b/packages/compiler/src/babel-plugin/parser.js
index f3a58ff70..ad83bf40d 100644
--- a/packages/compiler/src/babel-plugin/parser.js
+++ b/packages/compiler/src/babel-plugin/parser.js
@@ -59,6 +59,7 @@ export function parseMarko(file) {
   let preservingWhitespaceUntil = preserveWhitespace;
   let onNext = noop;
   const positionAt = (index) => toBabelPosition(parser.positionAt(index));
+  const offsetAt = (index) => parser.offsetAt(index);
   const locationAt = (range) => {
     const { start, end } = parser.locationAt(range);
     return {
@@ -700,7 +701,11 @@ export function parseMarko(file) {
     },
   });
 
-  parser.parse(code);
+  parser.parse(code, {
+    startOffset: htmlParseOptions.startOffset,
+    startLine: htmlParseOptions.startLine,
+    startColumn: htmlParseOptions.startColumn,
+  });
   onNext();
 
   for (let i = 0; i < parseVisits.length;) {
@@ -709,14 +714,47 @@ export function parseMarko(file) {
 
   const { ast } = file;
   const { program } = ast;
-  ast.start = program.start = 0;
-  ast.end = program.end = code.length - 1;
+
+  // htmlParseOptions.startOffset rebases every start/end offset htmljs-parser
+  // reported onto the enclosing document. loc (line/column) is already base-
+  // aware at the source (positionAt/locationAt, patched in htmljs-parser), so
+  // only the plain numeric offsets need shifting here, once, after parsing:
+  // shifting them as each node was built would have made every node's start
+  // absolute while its still-being-built ancestors and siblings expected it
+  // fragment relative (locationAt(node) reads node.start/node.end back).
+  const baseOffset = htmlParseOptions.startOffset;
+  if (baseOffset) shiftOffsets(ast, baseOffset, new Set());
+
+  ast.start = program.start = offsetAt(0);
+  ast.end = program.end = offsetAt(code.length - 1);
   ast.loc = program.loc = {
-    start: { line: 1, column: 0 },
-    end: positionAt(ast.end),
+    start: positionAt(0),
+    end: positionAt(code.length - 1),
   };
 }
 
+/**
+ * Shifts every start/end numeric offset in a Marko/Babel tree by `delta`.
+ * loc (line/column) positions are not touched here — they are already
+ * base-aware from the source (see htmlParseOptions above).
+ */
+function shiftOffsets(node, delta, seen) {
+  if (!node || typeof node !== "object") return;
+  if (seen.has(node)) return;
+  seen.add(node);
+  if (Array.isArray(node)) {
+    for (const item of node) shiftOffsets(item, delta, seen);
+    return;
+  }
+  if (typeof node.start === "number") node.start += delta;
+  if (typeof node.end === "number") node.end += delta;
+  for (const key in node) {
+    if (key === "loc" || key === "extra" || key === "tagDef") continue;
+    const value = node[key];
+    if (value && typeof value === "object") shiftOffsets(value, delta, seen);
+  }
+}
+
 function sortByStart(a, b) {
   return a.start - b.start;
 }
diff --git a/packages/compiler/src/babel-utils/loc.js b/packages/compiler/src/babel-utils/loc.js
index c3846ba25..c6aa97539 100644
--- a/packages/compiler/src/babel-utils/loc.js
+++ b/packages/compiler/src/babel-utils/loc.js
@@ -1,7 +1,19 @@
 const LINE_INDEX_KEY = Symbol();
 
+function getBase(file) {
+  return file.markoOpts?.htmlParseOptions ?? {};
+}
+
+function applyBase(base, loc) {
+  if (!base.startLine && !base.startColumn) return loc;
+  return {
+    line: loc.line + (base.startLine || 0),
+    column: loc.line === 1 ? loc.column + (base.startColumn || 0) : loc.column,
+  };
+}
+
 export function getLoc(file, index) {
-  return findLoc(getLineIndexes(file), 0, index);
+  return applyBase(getBase(file), findLoc(getLineIndexes(file), 0, index));
 }
 
 export function getLocRange(file, start, end) {
@@ -11,18 +23,19 @@ export function getLocRange(file, start, end) {
   if (startLoc) {
     const endLoc =
       start === end ? startLoc : findLoc(lineIndexes, startLoc.line - 1, end);
+    const base = getBase(file);
 
     return {
-      start: startLoc,
-      end: endLoc,
+      start: applyBase(base, startLoc),
+      end: applyBase(base, endLoc),
     };
   }
 }
 
 export function withLoc(file, node, start, end) {
   node.loc = getLocRange(file, start, end);
-  node.start = start;
-  node.end = end;
+  node.start = start + (getBase(file).startOffset || 0);
+  node.end = end + (getBase(file).startOffset || 0);
   return node;
 }
 
diff --git a/packages/compiler/src/babel-utils/parse.js b/packages/compiler/src/babel-utils/parse.js
index 71ce0864a..53f6c8a12 100644
--- a/packages/compiler/src/babel-utils/parse.js
+++ b/packages/compiler/src/babel-utils/parse.js
@@ -129,9 +129,10 @@ function tryParse(
   const { parserOpts } = file.opts;
 
   if (typeof sourceStart === "number") {
+    const baseOffset = file.markoOpts?.htmlParseOptions?.startOffset || 0;
     const startLoc = getLoc(file, sourceStart);
     const startLine = startLoc.line;
-    let startIndex = sourceStart;
+    let startIndex = sourceStart + baseOffset;
     let startColumn = startLoc.column;
 
     if (sourceOffset) {
@@ -196,14 +197,15 @@ function ensureParseError(file, node, sourceStart, sourceEnd) {
 function createParseError(file, sourceStart, sourceEnd, label, errorLoc) {
   file.___hasParseErrors = true;
   const loc = getLocRange(file, sourceStart, sourceEnd);
+  const startOffset = file.markoOpts?.htmlParseOptions?.startOffset || 0;
   return {
     type: "MarkoParseError",
     source: file.code.slice(sourceStart, sourceEnd),
     label: label.replace(/ *\(\d+:\d+\)$/, ""),
     errorLoc: errorLoc && getBoundedRange(loc, errorLoc),
     loc,
-    start: sourceStart,
-    end: sourceEnd,
+    start: sourceStart + startOffset,
+    end: sourceEnd + startOffset,
   };
 }
 
diff --git a/packages/compiler/test/parser-locations.test.js b/packages/compiler/test/parser-locations.test.js
index 37484f16d..2e91a6a73 100644
--- a/packages/compiler/test/parser-locations.test.js
+++ b/packages/compiler/test/parser-locations.test.js
@@ -32,13 +32,98 @@ describe("compiler/parser-locations", () => {
       end: { line: 1, column: 10 },
     });
   });
+
+  describe("htmlParseOptions base position", () => {
+    it("rebases a tag's loc onto the enclosing document", () => {
+      // MarkoTag nodes carry no numeric start/end at all (only loc) -- see
+      // the doc comment on the paired fix in mx's own fragment.ts stopgap.
+      const { ast } = compileSync("<div>hi</div>", "fragment.marko", {
+        ast: true,
+        code: false,
+        output: "source",
+        htmlParseOptions: {
+          startOffset: 100,
+          startLine: 5,
+          startColumn: 8,
+        },
+      });
+      const tag = ast.program.body[0];
+      assert.deepEqual(JSON.parse(JSON.stringify(tag.loc)), {
+        start: { line: 6, column: 8 },
+        end: { line: 6, column: 21 },
+      });
+    });
+
+    it("rebases the offset index inside a nested expression's loc", () => {
+      // MarkoTag/MarkoAttribute/the tag-name StringLiteral carry no numeric
+      // start/end at all in this compile mode -- only loc. A nested Babel
+      // expression node is where a numeric offset exists, and it lives at
+      // loc.start.index (mx's own fragment.ts documents the same shape).
+      const { ast } = compileSync("<div a=1></div>", "fragment.marko", {
+        ast: true,
+        code: false,
+        output: "source",
+        htmlParseOptions: {
+          startOffset: 100,
+          startLine: 5,
+          startColumn: 8,
+        },
+      });
+      const tag = ast.program.body[0];
+      const value = tag.attributes[0].value;
+      // Raw index of "1" in "<div a=1></div>" is 7; +100 base offset = 107.
+      assert.equal(value.loc.start.index, 107);
+    });
+
+    it("rebases a later line's line only, leaving its column alone", () => {
+      const text = firstText("<div>\n  hi\n</div>", {
+        startOffset: 50,
+        startLine: 4,
+        startColumn: 3,
+      });
+      assert.deepEqual(JSON.parse(JSON.stringify(text.loc)), {
+        start: { line: 6, column: 2 },
+        end: { line: 6, column: 4 },
+      });
+    });
+
+    it("rebases a thrown parse error's position", () => {
+      assert.throws(
+        () => {
+          compileSync("<div", "fragment.marko", {
+            ast: true,
+            code: false,
+            output: "source",
+            htmlParseOptions: {
+              startOffset: 90,
+              startLine: 7,
+              startColumn: 4,
+            },
+          });
+        },
+        (err) => {
+          assert.equal(err.loc.start.line, 8);
+          return true;
+        },
+      );
+    });
+
+    it("behaves exactly as before when htmlParseOptions is absent", () => {
+      const text = firstText("<div>\n    hello\n</div>");
+      assert.deepEqual(JSON.parse(JSON.stringify(text.loc)), {
+        start: { line: 2, column: 4 },
+        end: { line: 2, column: 9 },
+      });
+    });
+  });
 });
 
-function firstText(src) {
+function firstText(src, htmlParseOptions) {
   const { ast } = compileSync(src, "text-loc.marko", {
     ast: true,
     code: false,
     output: "source",
+    ...(htmlParseOptions ? { htmlParseOptions } : {}),
   });
   return ast.program.body[0].body.body[0];
 }
