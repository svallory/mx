import type { Filter } from "./types";

export function Footer(props: {
  itemsLeft: number;
  filter: Filter;
  hasCompleted: boolean;
  onClearCompleted: () => void;
}) {
  return (
    <footer class="footer">
      <span class="todo-count">
        <strong>${props.itemsLeft}</strong> ${props.itemsLeft === 1 ? "item" : "items"} left
      </span>
      <ul class="filters">
        <li>
          <a href="#/" class={selected: props.filter === "all"}>All</a>
        </li>
        <li>
          <a href="#/active" class={selected: props.filter === "active"}>Active</a>
        </li>
        <li>
          <a href="#/completed" class={selected: props.filter === "completed"}>Completed</a>
        </li>
      </ul>
      <if=props.hasCompleted>
        <button class="clear-completed" onClick() { props.onClearCompleted() }>
          Clear completed
        </button>
      </if>
    </footer>
  );
}
