{
  "name": "mx",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "for d in packages/*/; do (cd \"$d\" && echo \"[typecheck] $d\" && bunx tsc --noEmit) || exit 1; done",
    "test": "vitest run",
    "lint": "biome check .",
    "verify": "bun run typecheck && bun run lint && bun run build && bun run test",
    "build": "cd packages/mx-parser && bun run build",
    "oracle": "bun run packages/oracle/src/report.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/generator": "7.29.8",
    "@babel/helper-validator-identifier": "7.28.5",
    "@babel/parser": "7.29.8",
    "@babel/preset-typescript": "7.29.7",
    "@babel/traverse": "7.29.8",
    "@babel/types": "7.29.8",
    "@biomejs/biome": "2.5.12",
    "@types/babel__core": "7.20.5",
    "@types/babel__helper-validator-identifier": "7.15.2",
    "@types/charcodes": "0.2.2",
    "@types/node": "26.5.1",
    "babel-preset-solid": "1.9.15",
    "charcodes": "0.2.0",
    "htmljs-parser": "5.15.0",
    "solid-js": "1.9.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
