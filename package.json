{
  "name": "mx",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "for d in packages/*/ examples/*/; do (cd \"$d\" && echo \"[typecheck] $d\" && bunx tsc --noEmit) || exit 1; done",
    "test": "vitest run --reporter=default --reporter=json --outputFile=vitest-results.json",
    "test:bun": "cd packages/translator && bun run test:bun",
    "test:grammar": "moon run tree-sitter-solidmx:test --force",
    "lint": "biome check .",
    "verify": "bun run scripts/pre-verify.ts && bun run build && bun run typecheck && bun run lint && bun run test && bun run test:bun && bun run test:grammar && bun run consumer-check:translator && bun run scripts/verify-coverage.ts",
    "build": "cd packages/mx-parser && bun run build && cd ../translator && bun run build",
    "consumer-check:translator": "bun run packages/translator/scripts/consumer-check.ts",
    "oracle": "bun run packages/oracle/src/report.ts",
    "oracle:marko": "bun run --tsconfig-override=tsconfig.base.json packages/oracle/src/report-marko.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/generator": "7.29.8",
    "@babel/helper-validator-identifier": "7.28.5",
    "@babel/parser": "7.29.8",
    "@babel/preset-typescript": "7.29.7",
    "@babel/traverse": "7.29.8",
    "@babel/types": "7.29.8",
    "@biomejs/biome": "2.5.12",
    "@solidjs/babel-plugin": "2.0.0-rc.7",
    "@solidjs/compiler": "2.0.0-rc.7",
    "@solidjs/web": "2.0.0-rc.7",
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "7.27.0",
    "@types/babel__helper-validator-identifier": "7.15.2",
    "@types/charcodes": "0.2.2",
    "@types/node": "26.5.1",
    "charcodes": "0.2.0",
    "htmljs-parser": "5.15.0",
    "playwright": "1.63.0",
    "solid-js": "2.0.0-rc.7",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "3.2.7"
  }
}
